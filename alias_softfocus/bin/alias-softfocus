#!/usr/bin/env node

import fs from "fs";
import path from "path";
import yaml from "js-yaml";
import { resolveAlias } from "../lib/resolve-alias.js";

const ALIASES_PATH = path.resolve("docs/control/ALIASES.yaml");
const cmd = process.argv[2];

function loadRegistry() {
  if (!fs.existsSync(ALIASES_PATH)) {
    console.error("ERROR: ALIASES.yaml not found");
    process.exit(1);
  }
  const raw = fs.readFileSync(ALIASES_PATH, "utf8");
  return yaml.load(raw);
}

if (!cmd) {
  console.error("Usage: alias-softfocus <command>");
  process.exit(1);
}

if (cmd === "list") {
  const registry = loadRegistry();

  if (!registry || !registry.aliases) {
    console.error("ERROR: Invalid alias registry structure");
    process.exit(1);
  }

  console.log("Available SoftFocus aliases:");
  Object.keys(registry.aliases).forEach(a => {
    console.log(`  ${a}`);
  });
  process.exit(0);
}

if (cmd === "docs") {
  console.log("Alias documentation available in docs/control/");
  process.exit(0);
}

// default: execute alias
try {
  const alias = resolveAlias(cmd);

  for (const target of alias.targets) {
    console.log(`[ALIAS] Running: ${target}`);
    const res = await import("child_process").then(m =>
      m.execSync(target, { stdio: "inherit", shell: true })
    );
  }
} catch (err) {
  console.error(`ERROR: ${err.message}`);
  process.exit(1);
}
