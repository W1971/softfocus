  "sections": {
    "latency": [
      { "id": "latency_01", "text": "Восстановление не возвращает стратегическую ясность к началу дня." },
      { "id": "latency_02", "text": "Вход в рабочее состояние занимает больше времени, чем ранее." },
      { "id": "latency_03", "text": "После выходных требуется длительное включение." },
      { "id": "latency_04", "text": "Даже после пауз ощущается задержка мышления." },
      { "id": "latency_05", "text": "Решения требуют большего стартового усилия." },
      { "id": "latency_06", "text": "Восстановление не подготавливает к новым решениям." },
      { "id": "latency_07", "text": "Утро начинается с ощущения незавершённой нагрузки." },
      { "id": "latency_08", "text": "Паузы не сокращают время входа в работу." },
      { "id": "latency_09", "text": "Мышление остаётся инерционным после отдыха." },
      { "id": "latency_10", "text": "Восстановление не снижает когнитивную вязкость." }
    ],
    "residual": [
      { "id": "residual_01", "text": "Фоновая умственная усталость сохраняется в течение дня." },
      { "id": "residual_02", "text": "Напряжение ощущается вне рабочих часов." },
      { "id": "residual_03", "text": "Даже простые вопросы требуют усилия." },
      { "id": "residual_04", "text": "Когнитивная усталость не снижается после пауз." },
      { "id": "residual_05", "text": "Мысли о решениях продолжаются во время отдыха." },
      { "id": "residual_06", "text": "Ощущение умственной перегруженности присутствует фоном." },
      { "id": "residual_07", "text": "Усталость ощущается непропорционально нагрузке." },
      { "id": "residual_08", "text": "Снижение сложности задач не снижает усталость." },
      { "id": "residual_09", "text": "Концентрация истощается раньше ожидаемого." },
      { "id": "residual_10", "text": "Усталость сохраняется между рабочими циклами." }
    ],
    "compensation": [
      { "id": "comp_01", "text": "Работоспособность удерживается за счёт усиленного контроля." },
      { "id": "comp_02", "text": "Используется давление на себя для поддержания темпа." },
      { "id": "comp_03", "text": "Решения принимаются через ускорение, а не ресурс." },
      { "id": "comp_04", "text": "Эффективность достигается перерасходом энергии." },
      { "id": "comp_05", "text": "Паузы используются для восстановления функции, а не ресурса." },
      { "id": "comp_06", "text": "Стабильность обеспечивается за счёт напряжения." },
      { "id": "comp_07", "text": "Контроль заменяет ощущение восстановления." },
      { "id": "comp_08", "text": "Работа продолжается несмотря на признаки истощения." },
      { "id": "comp_09", "text": "Используются внешние стимулы для поддержания работоспособности." },
      { "id": "comp_10", "text": "Ресурс компенсируется дисциплиной и жёсткостью." }
    ],
    "predictability": [
      { "id": "pred_01", "text": "Одинаковый отдых даёт разный эффект." },
      { "id": "pred_02", "text": "Результат восстановления трудно предсказать." },
      { "id": "pred_03", "text": "Снижение нагрузки не гарантирует улучшения." },
      { "id": "pred_04", "text": "Восстановление нестабильно между циклами." },
      { "id": "pred_05", "text": "Планирование учитывает неполное восстановление." },
      { "id": "pred_06", "text": "Эффект пауз меняется без ясной причины." },
      { "id": "pred_07", "text": "Даже длительный отдых не даёт ожидаемого эффекта." },
      { "id": "pred_08", "text": "Режим восстановления трудно стабилизировать." },
      { "id": "pred_09", "text": "Восстановление зависит от трудно контролируемых факторов." },
      { "id": "pred_10", "text": "Предсказуемость ресурса снижена." }
    ],
    "detachment": [
      { "id": "det_01", "text": "Возникает эмоциональная дистанция от решений." },
      { "id": "det_02", "text": "Работа ощущается механической." },
      { "id": "det_03", "text": "Результаты не приносят удовлетворения." },
      { "id": "det_04", "text": "Вовлечённость снижена без явной причины." },
      { "id": "det_05", "text": "Принятие решений ощущается отстранённым." },
      { "id": "det_06", "text": "Интерес к управлению ослабевает." },
      { "id": "det_07", "text": "Эмоциональный отклик на успехи снижен." },
      { "id": "det_08", "text": "Рабочие процессы переживаются без участия." },
      { "id": "det_09", "text": "Возникает дистанция к ответственности." },
      { "id": "det_10", "text": "Работа выполняется без внутреннего включения." }
    ]
  }
}
